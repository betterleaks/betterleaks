{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Betterleaks v2 credential report",
  "description": "Sanitized result from AnalyzeCredential, ValidateCredential, or the analyze and validate commands. It omits supplied credential material and source locations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "rule_id": {
      "type": "string"
    },
    "attributes": {
      "$ref": "finding.schema.json#/$defs/stringMap"
    },
    "analysis": {
      "$ref": "finding.schema.json#/$defs/analysis"
    },
    "component_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "components"
        ],
        "properties": {
          "components": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id"
              ],
              "properties": {
                "rule_id": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            }
          },
          "analysis": {
            "$ref": "finding.schema.json#/$defs/analysis"
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 2,
      "rule_id": "example-key",
      "analysis": {
        "status": "valid",
        "identity": {
          "username": "example-user"
        },
        "capabilities": [
          "read"
        ],
        "severity": "medium"
      }
    }
  ]
}
